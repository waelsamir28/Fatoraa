{
  "name": "algamal-desktop",
  "productName": "FATORA",
  "version": "1.0.0",
  "description": "برنامج FATORA - لإدارة المحلات التجارية",
  "author": "برنامج FATORA - 01222355769",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node scripts/prepare.cjs",
    "start": "npm run prepare-app && electron .",
    "dev": "electron . --dev",
    "dist": "npm run prepare-app && electron-builder --win --x64 --publish never",
    "dist:portable": "npm run prepare-app && electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.algamal.pos",
    "productName": "FATORA",
    "executableName": "AlGamal",
    "copyright": "© برنامج FATORA - الدعم الفني 01222355769",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": ["main.cjs", "preload.cjs", "splash.html", "build/icon.png", "build/logo-fatora.png", "package.json"],
    "extraResources": [
      {
        "from": "app-server",
        "to": "app-server",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FATORA",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "AlGamal-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AlGamal-Portable-${version}.${ext}"
    }
  }
}
