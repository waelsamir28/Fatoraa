{
  "name": "algamal-desktop",
  "productName": "FATORA",
  "version": "1.9.3",
  "description": "برنامج FATORA - لإدارة المحلات التجارية",
  "author": "برنامج FATORA - 01222355769",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node scripts/prepare.cjs",
    "installer:build": "node installer-src/buildSetup.cjs",
    "installer:payload": "node installer-src/writePayload.cjs",
    "dist": "npm run prepare-app && electron-builder --win --x64 --publish always && npm run installer:build && npm run installer:payload",
    "dist:setup": "npm run prepare-app && electron-builder --win --x64 --publish never && npm run installer:build && npm run installer:payload",
    "dist:portable": "npm run prepare-app && electron-builder --win portable --x64 --publish never",
    "dist:local": "npm run prepare-app && electron-builder --win --x64 --publish never && npm run installer:build && npm run installer:payload"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.algamal.pos",
    "productName": "FATORA",
    "executableName": "AlGamal",
    "copyright": "© برنامج FATORA - الدعم الفني 01222355769",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "splash.html",
      "cloud.json",
      "build/icon.png",
      "build/logo-fatora.png",
      "package.json",
      "splash.png",
      "build/splash.png"
    ],
    "extraResources": [
      {
        "from": "app-server",
        "to": "app-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FATORA",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "AlGamal-Setup-${version}.${ext}",
      "include": "installer/win11.nsh",
      "menuCategory": "FATORA"
    },
    "portable": {
      "artifactName": "AlGamal-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "waelsamir28",
        "repo": "Fatoraa",
        "releaseType": "release"
      }
    ],
    "generateUpdatesFilesForAllChannels": true
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "pg": "^8.20.0"
  }
}
